# Keys that sign Swage's version tags and the official plugins' version tags, in ssh-keygen's allowed signers format:
#
#   releases@swagedeploy.app namespaces="git" ssh-ed25519 AAAA...
#
# Once a key is listed, Swage only updates itself, and installs and updates official plugins, from tags signed with
# one of these keys. With none listed, tags are not checked.

releases@swagedeploy.app namespaces="git" ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIFP4CqJfY7wvSn55BvKssi6EgNaWW8PGhuF+yBNd2rAO

# The CI release key, used by the Release workflow once a maintainer approves the run. Remove this line to stop trusting it.
releases-ci@swagedeploy.app namespaces="git" ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIPQd8F09CVs0anNKlBSHlLba7qLobIR99kECgwFxZw6S

# The CI release key used until 2026-10-31, kept so the tags it signed are still trusted.
releases-ci@swagedeploy.app namespaces="git" ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIDHt2YYR96A0CzuMyB2jYeFo4TLEmIs2gpcki5I8WUc4
